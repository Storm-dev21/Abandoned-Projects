#include <iostream>
#include <string>
#include <algorithm>
#include <vector>

using namespace std;

string substitutionEncrypt(string plaintext) {
    string ciphertext = plaintext;
    for (char& c : ciphertext) {
        if (isalpha(c)) {
            char base = islower(c) ? 'a' : 'A';
            c = (c - base + 3) % 26 + base; 
        }
    }
    return ciphertext;
}

string substitutionDecrypt(string ciphertext) {
    string plaintext = ciphertext;
    for (char& c : plaintext) {
        if (isalpha(c)) {
            char base = islower(c) ? 'a' : 'A';
            c = (c - base + 23) % 26 + base; 
        }
    }
    return plaintext;
}

string transpositionEncrypt(string plaintext) {
    string ciphertext = plaintext;
    int length = ciphertext.length();
    for (int i = 0; i < length / 2; i++) {
        swap(ciphertext[i], ciphertext[length - i - 1]); 
    }
    return ciphertext;
}

string transpositionDecrypt(string ciphertext) {
    return transpositionEncrypt(ciphertext); 
}

int main() {
    string plaintext = "pneumonoultramicroscopicsilicovolcanoconiosis";
    string ciphertext = plaintext;
    int encryptionCount = 0;
    while (encryptionCount < 6) {  
        ciphertext = substitutionEncrypt(ciphertext);
        
    }
    ciphertext = transpositionEncrypt(ciphertext);

    string decryptedText = ciphertext;
    int decryptionCount = 0;
    while (decryptionCount < 6) { 
        decryptedText = substitutionDecrypt(decryptedText);
        
    }
    decryptedText = transpositionDecrypt(decryptedText);

    cout << "Decrypted text: " << decryptedText << endl;

    return 0;
}
